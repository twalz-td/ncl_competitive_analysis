let foe = "royal", lens = "overview";

const QUAD_META = [["s","Strengths","+"],["w","Weaknesses","–"],["o","Opportunities","↗"],["t","Threats","⚠"]];

function renderSwot(el, data){
  el.innerHTML = "";
  QUAD_META.forEach(([k,label,glyph])=>{
    const items = (data[k]||[]).map(x=>`<li>${x}</li>`).join("");
    const d = document.createElement("div");
    d.className = `quad ${k} fade`;
    d.innerHTML = `<div class="quad-label"><span class="glyph">${glyph}</span>${label}</div><ul>${items}</ul>`;
    el.appendChild(d);
  });
}

function renderPriceBand(){
  const scale = document.getElementById("pb-scale");
  scale.innerHTML = "";
  PRICE_BAND.forEach(p=>{
    const m = document.createElement("div");
    m.className = "pb-mark";
    m.style.left = p.pos + "%";
    const color = p.home ? "var(--home)" : (p.k==="royal"?"var(--royal)":p.k==="msc"?"var(--msc)":p.k==="princess"?"var(--princess)":"var(--celebrity)");
    m.style.color = color;
    m.innerHTML = `<span class="nm"${p.home?' style="text-shadow:0 0 10px var(--home-glow)"':''}>${p.name}</span><span class="pin"></span><span class="pr">${p.label}</span>`;
    scale.appendChild(m);
  });
}

function render(){
  const F = FOES[foe];
  document.documentElement.style.setProperty("--challenger", `var(${F.accent})`);

  // labels
  document.getElementById("foe-name").textContent = F.name;
  document.getElementById("foe-tag").textContent = F.tags[lens];
  document.getElementById("home-tag").textContent = HOME_TAGS[lens];
  document.getElementById("ro-matchup").textContent = `NCL vs. ${F.name}`;
  document.getElementById("ro-lens").textContent = LENSES.find(l=>l[0]===lens)[1];
  document.getElementById("end-l").textContent = `${F.short} leads`;
  document.getElementById("foe-badge").textContent = "Challenger";

  // swots
  renderSwot(document.getElementById("home-swot"), NCL[lens]);
  renderSwot(document.getElementById("foe-swot"), F.swot[lens]);

  // gauge
  const idx = F.index[lens];               // -100..100  (+ = NCL advantage)
  const pct = 50 + idx/2;                    // 0..100
  const needle = document.getElementById("needle");
  needle.style.left = pct + "%";
  needle.style.borderColor = idx>=0 ? "var(--home)" : `var(${F.accent})`;
  document.getElementById("ro-index").textContent = (idx>0?"+":"") + idx;
  document.getElementById("ro-index").style.color = idx>=0 ? "var(--home)" : `var(${F.accent})`;
  document.getElementById("ro-take").innerHTML = F.take[lens];

  // pricing band visibility
  document.getElementById("priceband").classList.toggle("show", lens==="pricing");

  // pressed states
  document.querySelectorAll("#foes .pill").forEach(b=>b.setAttribute("aria-pressed", b.dataset.foe===foe));
  document.querySelectorAll("#lenses .pill").forEach(b=>b.setAttribute("aria-pressed", b.dataset.lens===lens));
}

