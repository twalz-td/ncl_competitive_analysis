let aSeason="W", aRegion="all";
function hexA(hex,a){ const h=hex.replace('#',''); return `rgba(${parseInt(h.slice(0,2),16)},${parseInt(h.slice(2,4),16)},${parseInt(h.slice(4,6),16)},${a})`; }

function renderAtlas(){
  let html = `<div class="ah port">Port</div>`;
  LCOLS.forEach(l=> html += `<div class="ah lcol" style="color:${LINES[l].color}">${LINES[l].short}</div>`);
  REGORD.forEach(rk=>{
    if(aRegion!=="all" && aRegion!==rk) return;
    const ports = DEPLOY.filter(p=>p.r===rk);
    if(!ports.length) return;
    html += `<div class="aregion">${REGIONMETA[rk]}</div>`;
    ports.forEach(p=>{
      const ex = p.excl ? `<span class="aexcl" style="color:${LINES[p.excl].color}">★ ${LINES[p.excl].short} only</span>` : "";
      const tag = p.tag ? `<span class="atag">${p.tag}</span>` : "";
      html += `<div class="acell portname"><div class="pn">${p.n}</div><div class="pl">${p.loc}${tag}</div>${ex}</div>`;
      LCOLS.forEach(l=>{
        const s=p.p[l]; const st = !s ? "none" : (s.includes(aSeason) ? "on" : "off");
        const bg = st==="on" ? LINES[l].color : st==="off" ? hexA(LINES[l].color,.24) : "#E7EAEE";
        html += `<div class="acell dc" style="background:${bg}" title="${p.n} · ${LINES[l].name}"></div>`;
      });
    });
  });
  document.getElementById("atlas").innerHTML = html;
  renderStats();
  document.querySelectorAll("#atlas-seasons .seasonbtn").forEach(b=>b.setAttribute("aria-pressed", b.dataset.s===aSeason));
  document.querySelectorAll("#atlas-regions .pill").forEach(b=>b.setAttribute("aria-pressed", b.dataset.r===aRegion));
}

function renderStats(){
  const ports = DEPLOY.filter(p=> aRegion==="all" || aRegion===p.r);
  const inView = ports.filter(p=> LCOLS.some(l=>p.p[l].includes(aSeason)));
  const nclN = inView.filter(p=> p.p.ncl.includes(aSeason)).length;
  const excl = inView.filter(p=> p.excl==="ncl" && p.p.ncl.includes(aSeason)).length;
  document.getElementById("atlas-stats").innerHTML =
    `<div class="statcard"><div class="sc-k">Ports in view</div><div class="sc-v">${inView.length}</div></div>`+
    `<div class="statcard"><div class="sc-k">NCL sails</div><div class="sc-v"><b style="color:var(--home)">${nclN}</b> <span>of ${inView.length}</span></div></div>`+
