function renderBrand(){
  const d = BRAND[selBrand];
  document.getElementById("bc-platform").textContent = d.platform;
  document.getElementById("bc-meta").textContent = d.meta;
  document.getElementById("bc-claims").textContent = d.claims;
  document.getElementById("bc-claimlist").innerHTML = d.claim.map(x=>`<li>${x}</li>`).join("");
  document.getElementById("bc-deliverlist").innerHTML = d.deliver.map(x=>`<li>${x}</li>`).join("");
  document.getElementById("bc-verdict").textContent = d.verdict;
  document.getElementById("bc-prod").textContent = d.prod;
  document.getElementById("bc-story").textContent = d.story;
  const n = document.getElementById("b-needle");
  n.style.left = d.align + "%";
  n.style.borderColor = d.color;
  const sc = document.getElementById("b-score");
  sc.textContent = d.align; sc.style.color = d.color;
  document.querySelectorAll("#brandselect .bpill").forEach(b=>b.setAttribute("aria-pressed", b.dataset.brand===selBrand));
}
