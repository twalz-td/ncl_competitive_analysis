
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Norwegian Cruise Line Competitive Analysis</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#EDF2F7;
    --abyss:#0B1E30;
    --deep:#EFF4F9;
    --panel:#FFFFFF; --panel-2:#FFFFFF;
    --line:#D4DEE8; --line-soft:#E5ECF3;
    --foam:#12283A; --mist:#4C6379; --faint:#6E8598;
    --home:#0C88AA; --home-dim:#8FD3E4; --home-glow:rgba(12,136,170,.12);
    --royal:#C68A14; --msc:#1E9E72; --princess:#8B5FC4; --celebrity:#7C899B;
    --s:#0F9A85; --w:#B07E28; --o:#2E7BC4; --t:#C64B4B;
    --shadow:0 18px 40px -22px rgba(30,60,95,.20);
    --challenger:var(--royal);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:
      radial-gradient(1200px 700px at 78% -8%, rgba(44,196,224,.10), transparent 60%),
      radial-gradient(900px 600px at 5% 110%, rgba(75,120,190,.10), transparent 55%),
      var(--bg);
    color:var(--foam);
    font-family:'Inter',system-ui,sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    min-height:100vh;
    padding:clamp(14px,2.4vw,34px);
  }
  .wrap{max-width:1280px;margin:0 auto}

  /* ---------- Header ---------- */
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:26px}
  .brand{display:flex;align-items:center;gap:11px;font-family:'Space Mono',monospace;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--mist)}
  .brand b{color:var(--foam);font-weight:700}
  .brand .dot{width:8px;height:8px;border-radius:50%;background:var(--home);box-shadow:0 0 0 4px var(--home-glow)}
  .prepared{font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--faint);border:1px solid var(--line);border-radius:999px;padding:7px 13px}
  .prepared b{color:var(--home)}

  .hero{position:relative;border:1px solid var(--line);border-radius:20px;overflow:hidden;
    background:linear-gradient(180deg,var(--panel) 0%,var(--panel-2) 100%);padding:clamp(22px,3.2vw,40px);margin-bottom:22px;box-shadow:var(--shadow);
    display:flex;flex-wrap:wrap;gap:18px 24px;justify-content:space-between;align-items:flex-start}
  .hero .contour{position:absolute;inset:0;opacity:.5;pointer-events:none}
  .hero-content{position:relative;z-index:2;max-width:680px;flex:1 1 440px;min-width:0}
  .hero .viewtabs{position:relative;z-index:2;margin-bottom:0;flex:none}
  .eyebrow{font-family:'Space Mono',monospace;font-size:11.5px;letter-spacing:.28em;text-transform:uppercase;color:var(--home);margin-bottom:14px}
  h1{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(30px,5vw,54px);line-height:1.02;letter-spacing:-.01em;margin-bottom:14px}
  h1 em{font-style:italic;color:var(--home)}
  .sub{color:var(--mist);font-size:clamp(14px,1.5vw,16.5px);max-width:640px}

  /* ---------- Controls ---------- */
  .controls{display:grid;grid-template-columns:1fr;gap:14px;margin-bottom:20px}
  .ctl-block{border:1px solid var(--line);border-radius:16px;background:var(--panel-2);padding:15px 17px}
  .ctl-label{font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint);margin-bottom:11px;display:flex;align-items:center;gap:9px}
  .ctl-label .num{color:var(--home)}
  .pillrow{display:flex;flex-wrap:wrap;gap:9px}
  button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
  .pill{border:1px solid var(--line);background:var(--deep);color:var(--mist);border-radius:11px;padding:10px 15px;font-size:13.5px;font-weight:500;letter-spacing:.01em;transition:all .18s ease;display:flex;align-items:center;gap:9px}
  .pill:hover{border-color:var(--faint);color:var(--foam);transform:translateY(-1px)}
  .pill .chip{width:9px;height:9px;border-radius:2.5px;flex:none}
  .pill[aria-pressed="true"]{color:var(--abyss);font-weight:600}
  .pill.challenger[aria-pressed="true"]{background:var(--challenger);border-color:var(--challenger)}
  .lens .pill[aria-pressed="true"]{background:var(--home);border-color:var(--home);color:var(--abyss)}
  .lens .pill[aria-pressed="true"] .lensdot{background:var(--abyss)}
  .lensdot{width:5px;height:5px;border-radius:50%;background:var(--faint)}

  /* ---------- Battle readout (signature) ---------- */
  .readout{border:1px solid var(--line);border-radius:18px;background:
     radial-gradient(600px 200px at 50% 0%, rgba(44,196,224,.08), transparent 70%),var(--panel);
     padding:clamp(18px,2.4vw,26px) clamp(18px,3vw,34px);margin-bottom:20px;box-shadow:var(--shadow)}
  .readout-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap;margin-bottom:16px}
  .readout-title{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--faint)}
  .readout-title b{color:var(--foam)}
  .verdict-index{font-family:'Space Mono',monospace;font-size:12.5px;color:var(--mist)}
  .verdict-index b{font-size:15px}

  .gauge{position:relative;height:64px;margin:6px 0 8px}
  .gauge-track{position:absolute;top:50%;left:0;right:0;height:10px;transform:translateY(-50%);
    border-radius:999px;overflow:hidden;border:1px solid var(--line-soft);
    background:linear-gradient(90deg, var(--challenger) 0%, rgba(147,173,198,.25) 50%, var(--home) 100%)}
  .gauge-center{position:absolute;top:6px;bottom:6px;left:50%;width:1.5px;transform:translateX(-50%);background:rgba(20,50,80,.30);z-index:3}
  .gauge-center::after{content:"PARITY";position:absolute;top:-16px;left:50%;transform:translateX(-50%);font-family:'Space Mono',monospace;font-size:8.5px;letter-spacing:.16em;color:var(--faint);white-space:nowrap}
  .needle{position:absolute;top:50%;width:20px;height:20px;border-radius:50%;transform:translate(-50%,-50%);
    background:var(--foam);border:3px solid var(--home);z-index:4;
    box-shadow:0 0 0 5px rgba(255,255,255,.85),0 6px 16px rgba(30,60,95,.20);
    transition:left .6s cubic-bezier(.34,1.2,.4,1),border-color .3s ease}
  .gauge-ends{display:flex;justify-content:space-between;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);position:absolute;left:0;right:0;bottom:-4px}
  .gauge-ends .l-end{color:var(--challenger)}
  .gauge-ends .r-end{color:var(--home)}

  .takeaway{display:flex;gap:13px;align-items:flex-start;border-top:1px solid var(--line-soft);padding-top:15px;margin-top:12px}
  .takeaway .tag{font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--abyss);background:var(--home);padding:5px 8px;border-radius:6px;flex:none;margin-top:2px;font-weight:700}
  .takeaway p{font-size:clamp(14px,1.6vw,16px);color:var(--foam);font-weight:500}
  .takeaway strong{color:var(--home);font-weight:600}

  /* ---------- SWOT arena ---------- */
  .arena{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
  .team{border:1px solid var(--line);border-radius:18px;background:var(--panel-2);overflow:hidden;box-shadow:var(--shadow)}
  .team-head{display:flex;align-items:center;gap:13px;padding:16px 20px;border-bottom:1px solid var(--line);position:relative}
  .team-head::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px}
  .team.home .team-head::before{background:var(--home)}
  .team.foe .team-head::before{background:var(--challenger)}
  .team-badge{font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;padding:5px 9px;border-radius:6px;font-weight:700}
  .team.home .team-badge{background:var(--home-glow);color:var(--home);border:1px solid var(--home-dim)}
  .team.foe .team-badge{background:rgba(0,0,0,.04);color:var(--challenger);border:1px solid var(--line)}
  .team-name{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(16px,2vw,21px);line-height:1.05}
  .team-tag{font-size:11.5px;color:var(--faint);margin-top:1px}

  .swot{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line-soft)}
  .quad{background:var(--panel-2);padding:15px 16px 16px;min-height:132px}
  .quad-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.14em;text-transform:uppercase;display:flex;align-items:center;gap:7px;margin-bottom:10px}
  .quad-label .glyph{width:15px;height:15px;border-radius:4px;display:grid;place-items:center;font-size:10px;font-weight:700;color:var(--abyss)}
  .quad.s .glyph{background:var(--s)} .quad.s .quad-label{color:var(--s)}
  .quad.w .glyph{background:var(--w)} .quad.w .quad-label{color:var(--w)}
  .quad.o .glyph{background:var(--o)} .quad.o .quad-label{color:var(--o)}
  .quad.t .glyph{background:var(--t)} .quad.t .quad-label{color:var(--t)}
  .quad ul{list-style:none;display:flex;flex-direction:column;gap:8px}
  .quad li{font-size:12.8px;line-height:1.4;color:var(--mist);padding-left:14px;position:relative}
  .quad li::before{content:"";position:absolute;left:0;top:7px;width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.45}
  .quad.s li{color:#177A6B}.quad.w li{color:#8A6420}.quad.o li{color:#2A6098}.quad.t li{color:#A44646}
  .quad li b{color:var(--foam);font-weight:600}
  .fade{animation:fade .45s ease}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

  /* ---------- Pricing band (pricing lens only) ---------- */
  .priceband{border:1px solid var(--line);border-radius:16px;background:var(--panel);padding:18px 20px 20px;margin-bottom:20px;display:none}
  .priceband.show{display:block;animation:fade .45s ease}
  .pb-head{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:8px;margin-bottom:16px}
  .pb-title{font-family:'Space Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint)}
  .pb-title b{color:var(--foam)}
  .pb-note{font-size:11px;color:var(--faint)}
  .pb-scale{position:relative;height:46px;border-radius:10px;background:linear-gradient(90deg,rgba(63,191,142,.14),rgba(75,155,224,.08) 55%,rgba(235,184,74,.16));border:1px solid var(--line-soft);margin-bottom:10px}
  .pb-mark{position:absolute;top:0;bottom:0;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}
  .pb-mark .pin{width:2px;height:14px;background:currentColor;border-radius:2px}
  .pb-mark .nm{font-family:'Space Mono',monospace;font-size:10.5px;font-weight:700;white-space:nowrap}
  .pb-mark .pr{font-size:10px;color:var(--faint);white-space:nowrap}
  .pb-axis{display:flex;justify-content:space-between;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint)}

  /* ---------- Footer ---------- */
  .foot{border-top:1px solid var(--line);padding-top:18px;display:flex;justify-content:space-between;gap:18px;flex-wrap:wrap}
  .foot p{font-size:11px;color:var(--faint);max-width:640px;line-height:1.55}
  .foot .method b{color:var(--mist)}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
  .legend span{display:flex;align-items:center;gap:6px}
  .legend i{width:9px;height:9px;border-radius:2px;display:inline-block}

  @media (max-width:820px){
    .arena{grid-template-columns:1fr}
    .team.foe{order:2}
  }
  @media (max-width:480px){
    .swot{grid-template-columns:1fr}
    .quad{min-height:0}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
  button:focus-visible,.pill:focus-visible{outline:2px solid var(--home);outline-offset:2px}
  @media print{
    body{background:var(--bg);-webkit-print-color-adjust:exact;print-color-adjust:exact}
    .controls{break-inside:avoid}.arena{break-inside:avoid}
  }
  /* ---------- View tabs ---------- */
  .viewtabs{display:inline-flex;gap:5px;background:var(--panel-2);border:1px solid var(--line);border-radius:13px;padding:5px;margin-bottom:22px}
  .viewtab{font-family:'Space Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mist);border-radius:9px;padding:10px 18px;transition:all .18s ease;display:flex;align-items:center;gap:8px}
  .viewtab:hover{color:var(--foam)}
  .viewtab[aria-pressed="true"]{background:var(--home);color:var(--abyss);font-weight:700}
  .viewtab .vt-dot{width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.6}
  .view[hidden]{display:none}

  /* ---------- Deployment map ---------- */
  .maplayout{display:grid;grid-template-columns:1fr 300px;gap:16px;align-items:start;margin-bottom:20px}
  .mapcard{position:relative;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:linear-gradient(180deg,#EAF2F8,#DCE9F3);box-shadow:var(--shadow)}
  svg.map{display:block;width:100%;height:auto}
  .mapcard .grid-line{stroke:#C6D6E4;stroke-width:.6;opacity:.5}
  .mapcard .contour{fill:none;stroke:#0C88AA;stroke-width:.8}
  .mapcard .region-label{fill:#5C7488;font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
  .node-ring{fill:none;stroke:#AFC2D2;stroke-width:1.1;opacity:.55}
  .plabel{font-family:'Inter',sans-serif;font-size:9px;fill:#45607A;pointer-events:none}
  .plabel.island{font-size:9px;font-weight:600}
  .petal{transition:transform .35s ease,opacity .35s ease}
  .diamond{transition:opacity .35s ease}
  .node{cursor:pointer}
  .node:hover .node-ring{stroke:var(--home);opacity:1}
  .tooltip{position:absolute;pointer-events:none;z-index:20;background:#FFFFFF;border:1px solid var(--line);border-radius:11px;padding:11px 13px;min-width:150px;box-shadow:0 12px 30px rgba(30,60,95,.20);opacity:0;transform:translateY(4px);transition:opacity .15s,transform .15s}
  .tooltip.show{opacity:1;transform:none}
  .tt-name{font-family:'Fraunces',serif;font-weight:600;font-size:14.5px;margin-bottom:2px}
  .tt-region{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.12em;text-transform:uppercase;color:var(--faint);margin-bottom:9px}
  .tt-lines{display:flex;flex-direction:column;gap:5px}
  .tt-line{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mist)}
  .tt-line .sw{width:9px;height:9px;border-radius:2.5px;flex:none}
  .tt-line.off{opacity:.3}
  .tt-line .szn{margin-left:auto;font-family:'Space Mono',monospace;font-size:8.5px;color:var(--faint);letter-spacing:.06em}
  .panel{border:1px solid var(--line);border-radius:16px;background:var(--panel-2);padding:16px 17px;margin-bottom:14px}
  .p-label{font-family:'Space Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint);margin-bottom:12px;display:flex;align-items:center;gap:8px}
  .p-label .num{color:var(--home)}
  .linebtn{display:flex;align-items:center;gap:10px;width:100%;border:1px solid var(--line);background:var(--deep);border-radius:11px;padding:10px 12px;margin-bottom:8px;transition:all .16s ease;color:var(--mist)}
  .linebtn:last-child{margin-bottom:0}
  .linebtn:hover{border-color:var(--faint);transform:translateX(2px)}
  .linebtn .sw{width:12px;height:12px;border-radius:3px;flex:none;transition:all .16s}
  .linebtn .nm{font-size:13.5px;font-weight:500}
  .linebtn .ct{margin-left:auto;font-family:'Space Mono',monospace;font-size:12px;color:var(--faint)}
  .linebtn[aria-pressed="false"] .sw{background:transparent!important;box-shadow:inset 0 0 0 1.5px currentColor}
  .linebtn[aria-pressed="false"]{opacity:.5}
  .linebtn[aria-pressed="true"] .nm{color:var(--foam)}
  .linebtn.home[aria-pressed="true"]{border-color:var(--home);box-shadow:0 0 0 1px var(--home-glow)}
  .seasonrow{display:flex;gap:7px}
  .seasonbtn{flex:1;border:1px solid var(--line);background:var(--deep);border-radius:10px;padding:9px 6px;font-size:11.5px;font-weight:500;color:var(--mist);transition:all .16s;text-align:center}
  .seasonbtn:hover{border-color:var(--faint);color:var(--foam)}
  .seasonbtn[aria-pressed="true"]{background:var(--home);border-color:var(--home);color:var(--abyss);font-weight:600}
  .season-sub{font-size:10.5px;color:var(--faint);margin-top:9px;line-height:1.4}
  .stat{display:flex;justify-content:space-between;align-items:baseline;padding:9px 0;border-bottom:1px solid var(--line-soft)}
  .stat:last-child{border-bottom:none}
  .stat .k{font-size:11.5px;color:var(--mist)}
  .stat .v{font-family:'Space Mono',monospace;font-size:16px;font-weight:700;color:var(--home)}
  .stat .v.small{font-size:12px;color:var(--foam);font-weight:400;text-align:right;max-width:150px}
  .insight{border:1px solid var(--line);border-left:3px solid var(--home);border-radius:12px;background:var(--panel);padding:13px 15px;margin-top:14px}
  .insight .tag{font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--home);margin-bottom:6px}
  .insight p{font-size:12.8px;color:var(--foam);line-height:1.5}
  .maplegend{display:flex;gap:13px;flex-wrap:wrap;font-family:'Space Mono',monospace;font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint)}
  .maplegend span{display:flex;align-items:center;gap:6px}
  .maplegend i{width:9px;height:9px;display:inline-block}
  .maplegend i.d{transform:rotate(45deg);border-radius:1px}
  .maplegend i.c{border-radius:50%}
  @media (max-width:960px){.maplayout{grid-template-columns:1fr}}

  /* ---------- Brand vs delivery ---------- */
  .brandlayout{display:grid;grid-template-columns:1fr 320px;gap:16px;align-items:start;margin-bottom:20px}
  @media (max-width:960px){.brandlayout{grid-template-columns:1fr}}
  .brandselect{display:flex;flex-wrap:wrap;gap:9px;margin-bottom:16px}
  .bpill[aria-pressed="true"]{background:var(--c);border-color:var(--c);color:var(--abyss);font-weight:600}
  .brandcard{border:1px solid var(--line);border-radius:18px;background:var(--panel-2);padding:clamp(18px,2.4vw,26px);box-shadow:var(--shadow)}
  .bc-head{border-bottom:1px solid var(--line-soft);padding-bottom:16px;margin-bottom:18px}
  .bc-platform{font-family:'Fraunces',serif;font-weight:600;font-size:clamp(20px,3vw,28px);line-height:1.06}
  .bc-meta{font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin-top:6px}
  .bc-claim{margin-top:13px;font-size:14px;color:var(--foam)}
  .bc-claim .lbl{font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--home);margin-right:8px}
  .ameter-top{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:6px}
  .ameter-title{font-family:'Space Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--faint)}
  .ameter-score{font-family:'Space Mono',monospace;font-size:12px;color:var(--mist)}
  .ameter-score b{font-size:16px}
  .ameter{position:relative;height:50px;margin:16px 0 6px}
  .ameter-track{position:absolute;top:50%;left:0;right:0;height:9px;transform:translateY(-50%);border-radius:999px;border:1px solid var(--line-soft);background:linear-gradient(90deg,#E27070 0%, #E0A64B 46%, #33B9A4 100%)}
  .ameter-needle{position:absolute;top:50%;width:18px;height:18px;border-radius:50%;transform:translate(-50%,-50%);background:var(--foam);border:3px solid var(--home);box-shadow:0 0 0 5px rgba(255,255,255,.85),0 6px 16px rgba(30,60,95,.20);transition:left .5s cubic-bezier(.34,1.2,.4,1),border-color .3s ease;z-index:3}
  .ameter-ends{position:absolute;left:0;right:0;bottom:-3px;display:flex;justify-content:space-between;font-family:'Space Mono',monospace;font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--faint)}
  .ameter-chips{display:flex;gap:9px;flex-wrap:wrap;margin-top:8px}
  .achip{font-size:11.5px;color:var(--mist);border:1px solid var(--line);border-radius:8px;padding:6px 11px}
  .achip b{color:var(--foam);margin-left:2px}
  .cd-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line-soft);border-radius:12px;overflow:hidden;margin-top:18px}
  @media (max-width:560px){.cd-grid{grid-template-columns:1fr}}
  .cd-col{background:var(--panel-2);padding:15px 16px}
